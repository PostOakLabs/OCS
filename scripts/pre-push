#!/usr/bin/env bash
# pre-push — mirrors Job 1 (Validate) in deploy.yml so CI failures are caught locally.
# Both #137 (stale llms.txt count) and #129 (dead links in hardened check) would have
# been caught here before reaching GitHub Actions.
#
# This file is the tracked master copy. Git does not install hooks from the repo,
# so every clone has to do it once:
#   cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Edit this file, not .git/hooks/pre-push, then re-run the copy.
#
# Skip for emergencies (use sparingly):
#   git push --no-verify

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "=== OCS pre-push validate ==="

# ── [1/9] Required files ─────────────────────────────────────────────────────
# Job 1's first step checks a hardcoded list of files that must exist. PR #20
# removed advisors.html while deploy.yml still listed it as required: the six
# gates below all passed locally, the push went out, and main went red.
#
# The list is PARSED FROM deploy.yml rather than duplicated here. A second copy
# would drift, and a drifted copy of a drift-detector is worse than none — it
# would pass locally for exactly the files CI is about to fail on.
echo "[1/9] Required-files gate (list read from deploy.yml)..."
WORKFLOW=".github/workflows/deploy.yml"
if [ ! -f "$WORKFLOW" ]; then
  echo "::error::$WORKFLOW not found — cannot verify the required-files list."
  exit 1
fi
# Pull the lines between `REQUIRED=(` and the closing `)`, strip whitespace/CR.
REQUIRED_LIST=$(sed -n '/REQUIRED=(/,/^ *)/p' "$WORKFLOW" \
  | sed '1d;$d' \
  | tr -d '\r' \
  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
  | grep -v '^$' || true)
if [ -z "$REQUIRED_LIST" ]; then
  echo "::error::Could not parse the REQUIRED=( ... ) block out of $WORKFLOW."
  echo "  If that step was renamed or restructured, update this parser to match."
  exit 1
fi
MISSING=0
while IFS= read -r f; do
  if [ ! -f "$f" ]; then
    echo "  MISSING: $f"
    MISSING=$((MISSING + 1))
  fi
done <<< "$REQUIRED_LIST"
COUNT=$(printf '%s\n' "$REQUIRED_LIST" | wc -l | tr -d ' ')
if [ "$MISSING" -gt 0 ]; then
  echo ""
  echo "$MISSING of $COUNT required file(s) missing."
  echo "Either restore the file, or drop it from the REQUIRED list in $WORKFLOW"
  echo "in the SAME commit that removes it — otherwise Job 1 fails and main goes red."
  exit 1
fi
echo "  all $COUNT required files present."

echo "[2/9] Count-drift gate..."
python3 scripts/verify-counts.py

echo "[3/9] Broken-link gate..."
python3 scripts/check-links.py

echo "[4/9] Stranded-page gate..."
python3 scripts/check-orphans.py

echo "[5/9] Sitemap-coverage gate..."
python3 scripts/check-sitemap.py

echo "[6/9] JS syntax check..."
node scripts/syntax-check.mjs

echo "[7/9] Forbidden-hash lint..."
node scripts/lint-forbidden-hash.mjs

echo "[8/9] Schema validation..."
node scripts/schema-validate.mjs

echo "[9/9] Copy-hallmarks gate (anti-AI-tell)..."
node scripts/check-copy-hallmarks.mjs

echo ""
echo "✅ All gates passed — pushing."
echo ""
echo "NOTE: this hook is a SUBSET of Job 1, not a mirror. Still CI-only:"
echo "  - the >=20 tool-file floor"
echo "  - node --test scripts/tests/tier-c-*.test.mjs"
echo "  - node --test scripts/tests/lib-imbh-constraints.test.mjs"
