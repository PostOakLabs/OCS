# inward-migration-economics.pdf was retired 2026-07-11 (rsync deploy has no
# --delete, so the stale file persists on the host); redirect to the HTML paper.
Redirect 301 /papers/inward-migration-economics.pdf /inward-migration-economics.html

# DreamHost's Apache runs .py as a CGI script by default, so the published
# figure-generation source mirror (papers/figs/*.py) returned 500 Internal
# Server Error instead of serving. These files are reproducibility SOURCE, not
# executables — serve them as readable plain text and strip any CGI handler.
RemoveHandler .py
AddType text/plain .py
<FilesMatch "\.py$">
  SetHandler none
  ForceType text/plain
</FilesMatch>
